# Rezepte-App: Einstellungen
#
# Diese Datei nach .env kopieren und die zwei Pflichtwerte ausfüllen:
#     cp .env.example .env
# Die Datei .env bleibt auf dem Server und kommt nie ins Git.

# PFLICHT: Die Domain, unter der die App erreichbar ist (ohne https://).
# Sie muss per DNS auf diesen Server zeigen, damit Caddy automatisch ein
# Zertifikat von Let's Encrypt holen kann. Für Tests auf dem eigenen
# Rechner: DOMAIN=localhost (dann stellt Caddy ein eigenes Zertifikat aus,
# der Browser warnt einmal).
DOMAIN=rezepte.example.ch

# PFLICHT: Passwort der Datenbank. Frei wählbar, wird nur zwischen den
# Containern benutzt. Lang und zufällig; ein Dollarzeichen vermeiden,
# weil Docker Compose es als Variable liest.
# Vorschlag erzeugen:  openssl rand -hex 24
DB_PASSWORD=

# ---- Optional, Vorgaben gelten, wenn die Zeile auskommentiert bleibt ----

# Wie viele Tage Backups in ./backups aufbewahrt werden.
#BACKUP_KEEP_DAYS=14

# Stunde (0-23, lokale Zeit nach TZ), zu der das tägliche Backup läuft.
#BACKUP_HOUR=3

# Wie viele Tage eine Anmeldung im Browser gültig bleibt.
#SESSION_DAYS=30

# Zeitzone für Logs und Backup-Zeitpunkt.
#TZ=Europe/Zurich
