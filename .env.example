# Nach .env kopieren: cp .env.example .env

# Lang und zufällig, ohne Dollarzeichen: openssl rand -hex 24
DB_PASSWORD=

# Optional, Vorgaben in Klammern:

# Port der App im internen Netz; der Proxy (NPM) zeigt auf ihn
#HTTP_PORT=8080

# true, wenn die App nur noch über HTTPS (NPM) benutzt wird
#COOKIE_SECURE=false

# Backups in ./backups aufbewahren (Tage)
#BACKUP_KEEP_DAYS=14

# Stunde des täglichen Backups, 0-23, lokale Zeit nach TZ
#BACKUP_HOUR=3

# Gültigkeit einer Anmeldung (Tage)
#SESSION_DAYS=30

# Zeitzone für Logs und Backup-Zeitpunkt
#TZ=Europe/Zurich
